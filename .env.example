# App
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-strong-random-secret
CRON_SECRET=replace-with-a-strong-random-secret
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Database / queue
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/openreply
REDIS_URL=redis://localhost:6379

# Google sign-in — the only sign-in method (magic link was removed). Create
# an OAuth client at console.cloud.google.com -> APIs & Services ->
# Credentials, authorized redirect URI: <NEXTAUTH_URL>/api/auth/callback/google.
# Without both set, the login page has nothing to sign in with.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Optional: restrict who can sign in to a comma-separated, case-insensitive
# allowlist. Without it, anyone who can complete the Google OAuth flow gets
# their own workspace.
# ALLOWED_EMAILS=you@example.com,teammate@example.com

# Meta / Instagram
META_GRAPH_API_VERSION=v25.0
INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret
FACEBOOK_APP_SECRET=your-facebook-app-secret
WEBHOOK_VERIFY_TOKEN=replace-with-a-webhook-verify-token
